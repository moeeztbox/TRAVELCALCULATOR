# --- JWT secrets (two different secrets — one for admin, one for user) ---
# Generate strong random values for real environments, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET_ADMIN=replace_with_a_long_random_admin_secret
JWT_SECRET_USER=replace_with_a_long_random_user_secret

# Optional: expirations (string format accepted by jsonwebtoken)
JWT_EXPIRES_ADMIN=7d
JWT_EXPIRES_USER=1d

# --- Database ---
# Local development: leave unset — falls back to a local MongoDB instance
# (mongodb://localhost:27017/travelcalculator).
# Production (Render): set to a cloud-accessible MongoDB connection string
# (e.g. a MongoDB Atlas URI).
MONGO_URI=mongodb://localhost:27017/travelcalculator

# --- CORS / cookies ---
# The frontend origin(s) allowed to call this API with credentials.
# Local development: leave unset — falls back to http://localhost:5173.
# Production (Render): set to the deployed Vercel frontend URL. Multiple
# origins (e.g. production + a Vercel preview URL) may be comma-separated.
FRONTEND_URL=http://localhost:5173

# Render sets this automatically; set explicitly to "production" here only
# if you need to test production cookie/CORS behavior locally.
NODE_ENV=development

# Render provides PORT automatically — no need to set it manually there.
# Only used for local development if you want a non-default port.
PORT=5000
