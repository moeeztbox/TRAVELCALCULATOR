# Backend API base URL, including the /api suffix.
#
# Local development: leave unset — falls back to http://localhost:5000/api
# (the local Express dev server), so no .env file is required to run
# `npm run dev`.
#
# Production (Vercel): set this in the Vercel project's Environment
# Variables to the deployed Render backend, e.g.:
#   VITE_API_URL=https://your-backend.onrender.com/api
VITE_API_URL=http://localhost:5000/api
